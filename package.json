{
  "name": "js-drizzle-store",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "tsx --env-file=.env src/demo.ts",
    "db:generate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file=.env node_modules/drizzle-kit/bin.cjs migrate",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "drizzle-zod": "0.8.3",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
